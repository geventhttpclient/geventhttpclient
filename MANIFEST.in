include src/geventhttpclient/*.py
include src/geventhttpclient/*.pyi
include src/geventhttpclient/py.typed
include ext/*.c
include ext/*.h
recursive-include vendor/llhttp *.h *.c LICENSE LICENSE-MIT
recursive-include vendor/nghttp2/lib *.c *.h LICENSE COPYING
# Generated by setup.py from ``vendor/nghttp2/lib/includes/nghttp2/
# nghttp2ver.h.in``. ``pip install -e .`` regenerates it before
# compilation; sdist wheels do not include the build/ directory, so a
# full Setuptools build from the unpacked sdist is required.
include build/include/nghttp2/nghttp2ver.h
graft tests
global-exclude __pycache__
global-exclude *.py[co]
include pyproject.toml
include README.md