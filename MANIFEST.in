include src/geventhttpclient/*.py
include src/geventhttpclient/*.pyi
include src/geventhttpclient/py.typed
include ext/*.c
include ext/*.h
recursive-include llhttp *.h *.c LICENSE LICENSE-MIT
recursive-include third-party/nghttp2/lib *.c *.h LICENSE COPYING
# build/include/nghttp2/nghttp2ver.h is generated by setup.py from the
# third-party/nghttp2/lib/includes/nghttp2/nghttp2ver.h.in template at
# build time. Build-trees created via ``pip install -e .`` produce it
# before extension compilation; ``sdist`` wheels currently need an
# out-of-tree build (full Setuptools build) to regenerate it. Future
# Phase 1 polish may move generation into a sdist-friendly hook.
include build/include/nghttp2/nghttp2ver.h
graft tests
global-exclude __pycache__
global-exclude *.py[co]
include pyproject.toml
include README.md